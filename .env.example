# ==============================================================================
# Concord Protocol - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL Database Connection
# Standard format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://concord_admin:concord_secret@localhost:5432/concord_db
POSTGRES_USER=concord_admin
POSTGRES_PASSWORD=concord_secret
POSTGRES_DB=concord_db

# LLM Provider (Google Gemini)
LLM_PROVIDER=google-gemini
LLM_API_KEY=your-google-gemini-api-key-here

# Concord Cryptographic Settings
# 32-byte hex seed for Ed25519 merchant signing keys
CONCORD_SIGNING_KEY_HEX=
CONCORD_DEFAULT_STRICTNESS=0.75

# Observability & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=info
